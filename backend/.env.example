# Полный перечень переменных backend. Значения ниже — для локальной разработки.
#
# Приложение читает конфигурацию только из окружения. Значения для dev-стенда —
# в deploy/dev/.env.example; для test и prod их задаёт CI Workflow. Различия сред
# и порядок добавления новой переменной — в корневом README, раздел «Среды».
#
# Пустая строка после «=» означает «не задано»: приложение возьмёт значение
# по умолчанию из application.yml или отключит зависящую от переменной функцию.

# --- среда --------------------------------------------------------------------
# Имя проекта compose: префикс контейнеров и томов локального окружения.
COMPOSE_PROJECT_NAME=workflow-crm
# Профиль Spring: dev, stage или prod. Определяет поведение (детали health,
# graceful shutdown, тестовый пользователь), но не адреса и не секреты.
SPRING_PROFILES_ACTIVE=dev
# Уровень логов кода приложения: DEBUG локально и на dev, INFO на test и prod.
LOG_LEVEL=DEBUG
# live — настоящие внешние сервисы, mock — заглушки. Сейчас переключает
# геокодер: в mock адрес объекта приходит как «Тестова адреса (широта, довгота)»
# с регионом Київ. На dev-стенде и test — mock, на prod — только live.
EXTERNAL_INTEGRATIONS_MODE=live

# --- порты на хосте -------------------------------------------------------------
# Порт занят другим процессом — поменяйте значение здесь.
# Внутри сети compose сервисы всегда видят друг друга на стандартных портах.
# PASSWORD_RESET_URL и USER_INVITATION_URL ниже ведут на client — при смене
# CLIENT_HOST_PORT поправьте порт и в них. Разрешённый для CORS адрес клиента
# compose берёт из CLIENT_HOST_PORT сам (переопределяется CORS_ALLOWED_ORIGINS).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8080
CLIENT_HOST_PORT=3000
MAILPIT_HOST_PORT=8025

# --- тестовые данные (только локально) ---------------------------------------
# Автоматический тестовый пользователь только для профиля dev. Заполните в локальном .env.
# Для внешнего SMTP укажите свой реальный адрес; пароль минимум 12 символов.
SEED_TEST_USER_EMAIL=
SEED_TEST_USER_PASSWORD=
# Пароль всех пользователей сида (docker compose run --rm seed), не короче 12 символов.
# Действует только на первом запуске сида: повторный существующих пользователей не меняет.
SEED_USER_PASSWORD=workflow-local-seed-password

# --- база данных ----------------------------------------------------------------
# POSTGRES_* создают базу в контейнере postgres; DB_* — то, чем подключается приложение.
POSTGRES_DB=workflow_crm
POSTGRES_USER=workflow_app
POSTGRES_PASSWORD=workflow_local_password
DB_URL=jdbc:postgresql://postgres:5432/workflow_crm
DB_USERNAME=workflow_app
DB_PASSWORD=workflow_local_password

# --- Redis: сессии, отозванные токены, лимиты попыток входа, кеш геокодера ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=workflow_redis_password

# --- RabbitMQ: брокер событий между модулями -----------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=workflow_app
RABBITMQ_PASSWORD=workflow_rabbit_password

# --- хранилище файлов (MinIO, S3-совместимое) ---------------------------------
# Адрес, по которому к MinIO ходит сам backend.
MINIO_ENDPOINT=http://minio:9000
# Адрес MinIO, который видит браузер: на нём подписываются ссылки на скачивание.
# Пусто — локально берётся порт MINIO_API_HOST_PORT.
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=workflow_minio_user
MINIO_SECRET_KEY=workflow_minio_password
# Бакеты файлов объектов и файлов задач.
FILE_BUCKET=workflow-files
TASK_FILE_BUCKET=workflow-task-files
# Максимальный размер одного файла, байт (20 МБ) и разрешённые расширения.
FILE_MAX_SIZE_BYTES=20971520
FILE_ALLOWED_EXTENSIONS=jpg,png,heic,pdf,docx,xlsx,dwg
# Сколько живёт подписанная ссылка на скачивание файла.
FILE_LINK_TTL=5m
# Фоновая чистка загрузок, которые не дошли до сохранения. false — только для отладки.
FILE_UPLOAD_CLEANUP_ENABLED=true

# --- сессии и токены ------------------------------------------------------------
# Ключ подписи JWT. На стендах — случайная строка от 32 символов, своя для каждой среды.
JWT_SECRET=workflow_local_jwt_signing_secret_change_me
JWT_ISSUER=workflow-crm
# Имена cookie и время жизни access- и refresh-токенов.
JWT_COOKIE_NAME=workflow_access_token
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_COOKIE_NAME=workflow_refresh_token
JWT_REFRESH_TOKEN_TTL=7d
# Максимальный срок сессии, сколько её ни продлевай.
REFRESH_SESSION_ABSOLUTE_TTL=30d
# Окно, в котором повторное использование refresh-токена не считается кражей
# (параллельные вкладки). Должно быть меньше JWT_ACCESS_TOKEN_TTL.
REFRESH_REUSE_GRACE_PERIOD=30s
# Cookie только по HTTPS. false допустим лишь локально без TLS.
JWT_COOKIE_SECURE=true
# Секрет шифрования курсоров списка объектов, минимум 32 символа.
# Не задан — ключ выводится из JWT_SECRET.
# OBJECT_LIST_CURSOR_SECRET=

# --- вход и защита учётных записей ---------------------------------------------
# Неудачных попыток до блокировки и длительность блокировки.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
# Unlock-action limit per superadmin; fixed window starts with the first action.
ADMIN_SECURITY_MAX_ACTIONS=10
ADMIN_SECURITY_RATE_WINDOW=1m
# Когда требовать подтверждение входа: NEW_DEVICE, PERIODICALLY или EVERY_LOGIN.
DEVICE_CONFIRMATION_MODE=NEW_DEVICE
# Сколько доверяем подтверждённому устройству и имя его cookie.
DEVICE_TRUST_DURATION=30d
DEVICE_COOKIE_NAME=workflow_device
# Срок жизни запроса на подтверждение входа и число попыток ввода кода из письма.
AUTH_CHALLENGE_TTL=5m
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# --- адреса клиента (домен фронтенда) ------------------------------------------
# Origin клиента через запятую. Пусто — CORS выключен, так и надо, когда клиент
# и API на одном origin. Локально compose подставляет http://localhost:CLIENT_HOST_PORT.
CORS_ALLOWED_ORIGINS=
# Страницы клиента, на которые ведут ссылки из писем.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
USER_INVITATION_URL=http://localhost:3000/set-password

# --- пользователи -----------------------------------------------------------------
# Роли, которым обязателен регион.
USER_REGION_REQUIRED_ROLES=MANAGER,REGIONAL_MANAGER,CONTRACT_MANAGER
# Срок действия приглашения и ссылки сброса пароля.
USER_INVITATION_TTL=72h
PASSWORD_RESET_TTL=30m

# --- Telegram ----------------------------------------------------------------------
# У каждой среды свой бот: локальный и dev, test и prod — разные боты.
# Боевой бот пишет сотрудникам Workflow, его токен существует только в prod.
# У бота один вебхук: /api/auth/telegram/webhook той среды, которой он принадлежит.
# Пусто — подтверждение входа и привязка Telegram отключены.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- почта --------------------------------------------------------------------------
# Mailpit принимает письма локально: http://localhost:8025, без внешней доставки.
# Для реальной почты замените сервер и доступы, включите аутентификацию и TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_SSL_ENABLED=false
# Адрес отправителя. Отдельные адреса для сброса пароля и приглашений;
# пустые — используется AUTH_EMAIL_FROM.
AUTH_EMAIL_FROM=no-reply@localhost
PASSWORD_RESET_MAIL_FROM=
USER_INVITATION_MAIL_FROM=

# --- геокодер -----------------------------------------------------------------------
# Используется только при EXTERNAL_INTEGRATIONS_MODE=live.
# Для больших нагрузок — собственный экземпляр Nominatim.
GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
# Forward search requires a self-hosted or otherwise approved Nominatim-compatible provider.
GEOCODING_SEARCH_URL=
GEOCODING_USER_AGENT=WorkflowCRM/0.1 (https://example.invalid/workflowcrmteams-group/workflow-crm)

# --- объекты ------------------------------------------------------------------------
# Поиск дублей: радиус в метрах и порог похожести названия (0..1).
OBJECT_DUPLICATE_RADIUS_METRES=50
OBJECT_DUPLICATE_NAME_SIMILARITY=0.6
# Выгрузка реестра: фоновый обработчик, пауза опроса очереди, бакет,
# срок хранения файла, срок ссылки и предельный размер файла (256 МБ).
OBJECT_EXPORT_WORKER_ENABLED=true
OBJECT_EXPORT_POLL_DELAY_MS=1000
OBJECT_EXPORT_BUCKET=workflow-exports
OBJECT_EXPORT_RETENTION=24h
OBJECT_EXPORT_LINK_TTL=5m
OBJECT_EXPORT_MAX_FILE_BYTES=268435456
# Удаление объектов: фоновый обработчик и пауза опроса очереди удаления.
OBJECT_DELETION_WORKER_ENABLED=true
OBJECT_DELETION_POLL_DELAY_MS=5000
