# Backend base URL. Required — the app fails to start without it.
# Baked into the browser bundle at build time (NEXT_PUBLIC_ prefix), so the
# browser calls the backend directly, not through the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Имя cookie сессии. Должно совпадать с JWT_COOKIE_NAME на backend: по ней
# src/proxy.ts решает, пускать ли на защищённые страницы.
# По умолчанию workflow_access_token — переменную можно не задавать.
NEXT_PUBLIC_SESSION_COOKIE_NAME=workflow_access_token
